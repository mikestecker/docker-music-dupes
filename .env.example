# Copy to .env and edit. Only MUSIC_PATH is required.

# Host path of your music library (mounted read-write at /music).
MUSIC_PATH=/path/to/music
# Host path for app state: tag cache, quarantine manifest, rules.
CONFIG_PATH=./config
# Host port for the web UI.
PORT=8095
# User/group that owns your music files (`id -u`, `id -g`).
PUID=1000
PGID=1000
TZ=UTC
# Hostnames you reach the UI by, if they're real domain names (e.g. a reverse
# proxy at dupes.example.com). IPs, single-word names and .local/.lan/.home.arpa
# names always work. Comma-separated.
ALLOWED_HOSTS=

# When two copies are otherwise equal, keep the one from these sources first
# (comma-separated, matched against the Source label). Empty turns it off.
PREFER_SOURCES=Tidarr
# When editions are otherwise equal, keep the remastered one. false prefers originals.
PREFER_REMASTERS=true
# Acoustic fingerprints (fpcalc) of every file in a duplicate group, full length.
# report: show what they find and what they'd change, decide without them.
# on: let them confirm or veto duplicates. off: skip them.
FINGERPRINT=report
# Parallel fpcalc processes. Empty uses every CPU the container is allowed.
FINGERPRINT_WORKERS=

# Image to run. Change if you publish your own fork.
# IMAGE=ghcr.io/mikestecker/docker-music-dupes:latest

# Optional: label each file with the download client Lidarr imported it from.
# LIDARR_MUSIC_ROOT is where the library lives inside Lidarr's container.
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_MUSIC_ROOT=/data/media/music
